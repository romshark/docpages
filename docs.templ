package docpages

import (
	"mime"
	"path"
	"strconv"

	"github.com/romshark/morpheus/neo"
)

// DefaultPage is [Layout] with a "Docs" header link to the first page,
// used when docs have no template.templ.
templ DefaultPage(p Page) {
	@Layout(p, Parts{HeaderLinks: HeaderLinks(p, Link{Title: "Docs", URL: readmeName})})
}

// Layout is the built-in page with template parts.
templ Layout(p Page, parts Parts) {
	<!DOCTYPE html>
	<html lang="en">
		@Head(p) {
			if parts.Head != nil {
				@parts.Head
			}
		}
		@Body(p) {
			if parts.Banner != nil {
				@parts.Banner
			}
			@Header(p) {
				if parts.HeaderLinks != nil {
					@parts.HeaderLinks
				}
			}
			<div class="docs">
				@Navigation(p)
				// Keep the footer here so navigation reaches the page end.
				<div class="docs-column">
					@Main(p)
					@Footer(p, parts.FooterEnd) {
						if parts.FooterLinks != nil {
							@parts.FooterLinks
						}
					}
				</div>
				@Contents(p)
			</div>
		}
	</html>
}

// Head renders a page's <head>: title, description, favicon, site styles and
// scripts, then children so their styles win the cascade.
templ Head(p Page) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ p.Title } - { p.Site }</title>
		<meta name="description" content={ p.Description }/>
		if !p.Indexed {
			<meta name="robots" content="noindex"/>
		}
		@favicon(p.Root, p.site.chrome.favicon)
		<link rel="alternate" type="text/markdown" href={ p.Markdown }/>
		@themeScript()
		<link rel="stylesheet" href={ p.Root + "morpheus/morpheus.min.css" }/>
		@morpheusIconBase(p.Root)
		<link rel="stylesheet" href={ p.Root + "docpages.css" }/>
		if p.site.chrome.style {
			<link rel="stylesheet" href={ p.Root + "style.css" }/>
		}
		<script type="module" src={ p.Root + "morpheus/morpheus.min.js" }></script>
		<script type="module" src={ p.Root + "docpages.js" }></script>
		if p.site.chrome.reload != "" {
			@reloadScript(p.Root+"../"+reloadPath, p.site.chrome.reload)
		}
		{ children... }
	</head>
}

// Body renders children in <body>. Styles use its class, search its root,
// and style.css its version. A skip link to <main> comes first.
templ Body(p Page) {
	<body
		class="docs-page"
		data-site-root={ p.Root }
		data-version={ p.Version }
	>
		@skipLink()
		{ children... }
	</body>
}

// Header renders the site logo, version menu, [Navigation] button, child links,
// repository, search, and theme controls.
templ Header(p Page) {
	<header class="site-header">
		<div class="brand">
			<a class="logo" href={ p.Home } aria-label={ p.Site + " home" }>
				if p.Logo != "" {
					@templ.Raw(p.Logo)
				} else {
					<span class="logo-text">{ p.Site }</span>
				}
			</a>
			@VersionSelect(p)
		</div>
		<nav aria-label="Site">
			@menuButton()
			{ children... }
			<a
				class="header-repository icon-link"
				href={ templ.SafeURL(p.Repository) }
			>
				@hostIcon(p.site.chrome.host)
				{ p.Host }
			</a>
			@Search(p)
			@Offline(p)
			@ThemeSwitch()
		</nav>
	</header>
}

// Offline renders the button that saves p's version for offline viewing,
// or nothing with [Options].NoOffline.
templ Offline(p Page) {
	if p.site != nil && !p.site.options.NoOffline {
		<div class="offline" data-offline-state="none" hidden>
			@neo.Popover(neo.PopoverOpts{
				Placement:    neo.Set(neo.PlacementBottomEnd),
				FollowScroll: neo.Set(neo.PopoverFollowScrollUntilTriggerInvisible),
			}) {
				// The aura runs during downloads.
				@neo.AuraAttrs(neo.AuraOpts{Disabled: neo.Set(true)},
					templ.Attributes{"class": "offline-aura"}) {
					<button
						type="button"
						class="offline-button"
						aria-label="Offline viewing"
						title="Offline viewing"
						{ neo.PopoverTrigger()... }
					>
						@icon("download")
						@icon("circle-check")
					</button>
				}
				<div class="offline-panel" { neo.PopoverContent()... }>
					<p class="offline-title">Offline viewing</p>
					// Apply saves the checked groups and drops the others.
					<div class="offline-choose">
						<p class="offline-saved-text">
							@icon("circle-check")
							Cached for offline viewing
						</p>
						@offlineOption(offlinePages, "Pages")
						@offlineOption(offlineImages, "Images")
						@offlineOption(offlineVideos, "Videos and audio")
						@neo.ButtonAttrs(neo.ButtonOpts{Size: neo.Set("sm"), Disabled: neo.Set(true)},
							templ.Attributes{"class": "offline-apply"}) {
							Apply
						}
						<p class="offline-error" role="alert"></p>
					</div>
					<div class="offline-saving">
						@neo.ProgressAttrs(neo.ProgressOpts[int]{
							HideValue: neo.Set(true),
							AriaLabel: neo.Set("Saving for offline viewing"),
						}, nil)
						<p class="offline-progress-text" aria-live="polite"></p>
						@neo.ButtonAttrs(neo.ButtonOpts{Size: neo.Set("sm")},
							templ.Attributes{"class": "offline-cancel"}) {
							Cancel
						}
					</div>
					<p class="offline-unavailable">
						Connect to the network to save these docs for offline viewing.
					</p>
				</div>
			}
		</div>
	}
}

// offlineOption is the checkbox of group in [Offline], checked when cached,
// with its size and an info button for a group too big to cache.
templ offlineOption(group, label string) {
	<div class="offline-option" data-group={ group }>
		<label>
			@neo.CheckboxAttrs(neo.CheckboxOpts{Size: neo.Set("sm")},
				templ.Attributes{"data-group": group})
			{ label }
			<span class="offline-size"></span>
		</label>
		<span class="offline-too-big" hidden>
			@neo.Tooltip(neo.TooltipOpts{Placement: neo.Set(neo.PlacementTop)}) {
				<button type="button" class="offline-info" aria-label={ label + " don't fit" }>
					@icon("info")
				</button>
				<span { neo.TooltipContent()... }></span>
			}
		</span>
	</div>
}

// menuButton opens [Navigation] over the page.
templ menuButton() {
	@neo.ButtonAttrs(neo.ButtonOpts{
		Variant: neo.Set(neo.ButtonVariantGhost),
	}, templ.Attributes{
		"id":            "docs-nav-toggle",
		"class":         "menu-button",
		"aria-controls": "docs-nav",
	}) {
		@icon("menu")
		Menu
	}
}

// Navigation is a wide-screen column and a narrow-screen overlay opened from [Header].
templ Navigation(p Page) {
	@neo.SidebarAttrs(neo.SidebarOpts{
		AriaLabel:         neo.Set("Documentation"),
		OverlayBreakpoint: neo.Set("56.25rem"),
	}, templ.Attributes{"id": "docs-nav", "class": "docs-nav"}) {
		<nav { neo.SidebarContent()... } aria-label="Documentation">
			@docsNav(p.Navigation)
		</nav>
	}
}

// Main renders <main>: the version note, narrow-screen contents, page text, and
// previous/next links.
templ Main(p Page) {
	<main class="docs-main" id="main-content" tabindex="-1">
		if p.Note != "" {
			@versionNote(p.Note)
		}
		// On narrow screens, a bar sticks below the header and opens over text.
		// It shows the page title until docs.ts replaces it with the current section title.
		if len(p.Contents) > 0 {
			<details class="toc-inline">
				<summary>
					<span class="toc-inline-current">
						{ p.Heading }
					</span>
					@icon("chevron-down")
				</summary>
				@docsContents(p.Contents)
			</details>
		}
		@pageLinks(p)
		<article class="docs-content">
			@templ.Raw(p.Body)
		</article>
		<footer class="docs-page-footer">
			@pageLinks(p)
			if p.Prev.Href != "" || p.Next.Href != "" {
				<nav class="pager" aria-label="Previous and next page">
					if p.Prev.Href != "" {
						<a
							class="pager-prev"
							href={ p.Prev.Href }
							rel="prev"
						>
							<span class="pager-label">Previous</span>
							{ p.Prev.Title }
						</a>
					}
					if p.Next.Href != "" {
						<a
							class="pager-next"
							href={ p.Next.Href }
							rel="next"
						>
							<span class="pager-label">Next</span>
							{ p.Next.Title }
						</a>
					}
				</nav>
			}
		</footer>
	</main>
}

// Contents lists sections beside the text on wide screens;
// it renders nothing when there are none.
templ Contents(p Page) {
	if len(p.Contents) > 0 {
		<aside class="docs-toc" aria-labelledby="docs-toc-title">
			<p class="toc-title" id="docs-toc-title">On this page</p>
			@docsContents(p.Contents)
		</aside>
	}
}

// Footer renders the site footer: repository, child links, llms.txt, then end if non-nil.
templ Footer(p Page, end templ.Component) {
	<footer class="site-footer">
		<nav class="footer-links" aria-label="Project">
			<a class="icon-link" href={ templ.SafeURL(p.Repository) }>
				@hostIcon(p.site.chrome.host)
				{ p.Host }
			</a>
			{ children... }
			<a class="icon-link" href={ p.Root + "llms.txt" }>
				@icon("file")
				llms.txt
			</a>
		</nav>
		if end != nil {
			@end
		}
	</footer>
}

// headerLinks renders links returned by [HeaderLinks].
templ headerLinks(links []linkView) {
	for _, l := range links {
		<a
			class={ "header-link", templ.KV("icon-link", l.Icon != nil) }
			href={ l.Href }
			if l.Current {
				aria-current="page"
			}
		>
			if l.Icon != nil {
				@l.Icon
			}
			{ l.Title }
		</a>
	}
}

// footerLinks renders links returned by [FooterLinks].
templ footerLinks(links []linkView) {
	for _, l := range links {
		<a class="icon-link" href={ l.Href }>
			if l.Icon != nil {
				@l.Icon
			}
			{ l.Title }
		</a>
	}
}

templ pageLinks(p Page) {
	<p class="page-meta">
		<a class="icon-link" href={ p.Markdown }>
			@icon("markdown")
			Raw Markdown
		</a>
		<a class="icon-link" href={ templ.SafeURL(p.Source) }>
			@hostIcon(p.site.chrome.host)
			View this page on { p.Host }
		</a>
	</p>
}

// favicon links tab icon name at the version root, using page-relative base.
// Empty name is a no-op.
templ favicon(base, name string) {
	if name != "" {
		<link
			rel="icon"
			href={ base + name }
			type={ mime.TypeByExtension(path.Ext(name)) }
		/>
	}
}

// morpheusIconBase points <neo-icon> to the version's morpheus/icons/ using
// page-relative base, replacing morpheus.min.css's /static/icons. <neo-icon>
// resolves the URL against the page.
templ morpheusIconBase(base string) {
	@templ.Raw(`<style>:root{--neo-icon-base:"` + base + `morpheus/icons"}</style>`)
}

// skipLink is every page's first element. The first Tab reveals it;
// it skips header and navigation to <main>, as WCAG 2.4.1 requires.
templ skipLink() {
	<a class="skip-link" href="#main-content">Skip to content</a>
}

// VersionSelect is the version menu; docs.ts opens the page in the chosen version.
// A site without releases has only main, and no menu.
templ VersionSelect(p Page) {
	if len(p.Versions) > 1 {
		@neo.SelectAttrs(neo.SelectOpts{
			Value:             neo.Set(currentVersion(p.Versions)),
			Size:              neo.Set("sm"),
			AriaLabel:         neo.Set("Documentation version"),
			PopoverFitContent: neo.Set(true),
		}, templ.Attributes{"class": "version-select"}) {
			for _, l := range p.Versions {
				@neo.OptionAttrs(neo.OptionOpts{Value: neo.Set(l.Version)}, templ.Attributes{
					"data-href":     l.Href,
					"data-fallback": l.Fallback,
				}) {
					{ l.Version }
				}
			}
		}
	}
}

// versionNote shows a page edition's note HTML.
templ versionNote(note string) {
	<p class="version-note" role="note">
		@templ.Raw(note)
	</p>
}

// hostIcon is h's repository-link icon: GitHub's mark by default,
// the configured host icon, or none.
templ hostIcon(h *host) {
	if h.icon != "" {
		@templ.Raw(h.icon)
	} else if h.github {
		@icon("github")
	}
}

// Search renders its button and dialog. docs.ts lists search.json results,
// or suggestions for an empty field.
templ Search(p Page) {
	@neo.DialogAttrs(neo.DialogOpts{}, templ.Attributes{"class": "search"}) {
		<button
			type="button"
			class="search-button"
			aria-keyshortcuts="/ Control+K Meta+K"
			{ neo.DialogTrigger()... }
		>
			@icon("search")
			<span class="search-label">Search</span>
			<kbd>/</kbd>
		</button>
		<dialog class="search-dialog" aria-label="Search the documentation">
			<div class="search-box" role="search">
				@icon("search")
				<input
					type="search"
					class="search-input"
					placeholder="Search the documentation"
					aria-label="Search the documentation"
					role="combobox"
					aria-expanded={ strconv.FormatBool(len(p.Suggested) > 0) }
					aria-controls="search-results"
					aria-autocomplete="list"
					autocomplete="off"
					spellcheck="false"
				/>
			</div>
			// Smoothly resize the dialog with its list.
			@neo.ElasticAttrs(neo.ElasticOpts{},
				templ.Attributes{"class": "search-body"}) {
				<p class="search-heading" hidden?={ len(p.Suggested) == 0 }>Suggested</p>
				<ul
					class="search-results"
					id="search-results"
					role="listbox"
					aria-label="Suggested pages"
				>
					// goldmark omits "_" from heading IDs, keeping these distinct.
					for i, s := range p.Suggested {
						<li
							id={ "search_suggestion_" + strconv.Itoa(i) }
							role="option"
							aria-selected="false"
						>
							<a href={ s.Href } tabindex="-1">
								<span class="result-page">{ s.Group }</span>
								<span class="result-section">{ s.Title }</span>
							</a>
						</li>
					}
				</ul>
				<p class="search-status" role="status"></p>
			}
			<p class="search-keys" aria-hidden="true">
				<span><kbd>&uarr;</kbd><kbd>&darr;</kbd> select</span>
				<span><kbd>&crarr;</kbd> open</span>
				<span><kbd>esc</kbd> close</span>
			</p>
		</dialog>
	}
}

// docsNav lists the groups of the navigation.
templ docsNav(groups []NavGroup) {
	for _, g := range groups {
		<div class="nav-group">
			<p class="nav-group-title">
				@templ.Raw(g.Icon)
				{ g.Title }
			</p>
			<ul>
				for _, l := range g.Links {
					<li>
						if l.External {
							<a href={ templ.SafeURL(l.Href) } class="nav-external">
								{ l.Title }
								@icon("arrow-up-right")
							</a>
						} else if l.Current {
							<a href={ l.Href } aria-current="page">{ l.Title }</a>
						} else {
							<a href={ l.Href }>{ l.Title }</a>
						}
					</li>
				}
			</ul>
		</div>
	}
}

// docsContents lists the contents of a page.
templ docsContents(toc []ContentsLink) {
	<ul class="toc">
		for _, e := range toc {
			<li class={ "level-" + strconv.Itoa(e.Level) }>
				<a href={ e.Href }>{ e.Title }</a>
			</li>
		}
	</ul>
}

// copyButton copies text from the code block with the given ID.
templ copyButton(id string) {
	@neo.Clipcopy(neo.ClipcopyOpts{For: neo.Set(id)}) {
		<button type="button" class="copy-button" aria-label="Copy the code">
			@neo.ClipcopyIdle() {
				Copy
			}
			@neo.ClipcopyCopied() {
				Copied
			}
		</button>
	}
}

// docsIndex is root index.html, which opens the first page of the edition at
// relative dir. GitHub Pages serves it without redirects.
templ docsIndex(dir string, c *chrome) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			// The script redirects before the stylesheets load; the refresh is
			// for browsers without scripts. replace keeps this page out of history.
			<script data-dir={ dir }>
				location.replace(document.currentScript.dataset.dir);
			</script>
			<meta http-equiv="refresh" content={ "0; url=" + dir }/>
			// Before the stylesheets load, the browser paints a dark canvas
			// in a dark system theme instead of a white one.
			<meta name="color-scheme" content="light dark"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ c.name } documentation</title>
			@favicon(dir, c.favicon)
			@themeScript()
			// The stylesheets of the version give the colors of its pages,
			// with those of the docs style.css, and are cached for them.
			<link rel="stylesheet" href={ dir + "docpages.css" }/>
			if c.style {
				<link rel="stylesheet" href={ dir + "style.css" }/>
			}
		</head>
		<body class="docs-index">
			<a class="docs-index-link" href={ dir }>
				if c.logo != "" {
					@templ.Raw(c.logo)
				} else {
					{ c.name }
				}
			</a>
		</body>
	</html>
}

// reloadScript reloads when [Handler]'s event stream at url reports a value
// other than state, the displayed page's state. It reconnects after server restarts.
//
// The page holds the stream only while visible. Browsers allow at most six
// HTTP/1.1 connections per server; back-cache and hidden-tab pages could use
// them all and stall the next page. The stream reports state on open,
// reloading pages whose files changed while hidden.
templ reloadScript(url, state string) {
	<script data-url={ url } data-state={ state }>
		(() => {
			const { url, state } = document.currentScript.dataset;
			let source = null;
			const open = () => {
				if (source === null && !document.hidden) {
					source = new EventSource(url);
					source.onmessage = (e) => {
						if (e.data !== state) {
							location.reload();
						}
					};
				}
			};
			const close = () => {
				source?.close();
				source = null;
			};
			addEventListener("pagehide", close);
			addEventListener("pageshow", open);
			document.addEventListener("visibilitychange", () => {
				if (document.hidden) {
					close();
				} else {
					open();
				}
			});
			open();
		})();
	</script>
}
