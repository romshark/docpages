{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": [],
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true
	},
	"include": ["docs.ts"]
}
